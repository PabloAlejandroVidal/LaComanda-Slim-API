@base = http://localhost/Programacion3/trabajoPractico-Final
@token_socio = YOUR_TOKEN_HERE
@token_mozo = YOUR_TOKEN_HERE
@sectorBartender = 1
@sectorChoperas = 2
@sectorCocina = 3
@sectorCandy = 4

### ==============================
### PRODUCTOS - LISTAR (PUBLICO)
### ==============================
GET {{base}}/productos

### ==============================
### PRODUCTOS - ALTA
### ==============================
POST {{base}}/productos
Authorization: Bearer {{token_socio}}
Content-Type: application/json

{
  "nombre": "Empanadas",
  "sector": "cocina",
  "precio": 3500
}

### ==============================
### PRODUCTOS - ALTA CON ROL INVÁLIDO
### ==============================
POST {{base}}/productos
Authorization: Bearer {{token_mozo}}
Content-Type: application/json

{
  "nombre": "Cerveza IPA",
  "sector": "cerveceria",
  "precio": 2800
}

### ==============================
### PRODUCTOS - EXPORTAR CSV
### ==============================
GET {{base}}/productos/export/csv
Authorization: Bearer {{token_socio}}